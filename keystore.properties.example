# Copia a keystore.properties y rellena con TU keystore real.
# Este archivo NUNCA se sube al repositorio (ver .gitignore).
#
# La ruta del store es relativa a la raíz del proyecto:
#   keytool -genkeypair -v -keystore paylensu-release.jks -alias paylensu \
#     -keyalg RSA -keysize 4096 -validity 10000
storeFile=paylensu-release.jks
storePassword=CAMBIA_ESTA_PASSWORD
keyAlias=paylensu
keyPassword=CAMBIA_ESTA_PASSWORD
